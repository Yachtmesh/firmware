# Enable Bluetooth
CONFIG_BT_ENABLED=y

# Select NimBLE as the BLE host stack (choice symbol)
CONFIG_BT_NIMBLE_ENABLED=y

# BLE-only controller mode (choice symbol)
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y

# NimBLE settings
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=3
CONFIG_BT_NIMBLE_LOG_LEVEL=1

# LittleFS via VFS
CONFIG_LITTLEFS_MAX_PARTITIONS=3

# Partition table
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# TWAI (CAN bus) for NMEA2000
CONFIG_TWAI_ISR_IN_IRAM=y

# FreeRTOS
CONFIG_FREERTOS_HZ=1000

# app_main() runs the entire application loop (NMEA2000, roles, BLE) on the
# IDF "main" task for the life of the program rather than just during init.
# The default 3584-byte stack is only sized for a brief init routine and
# overflows under NimBLE's GATT notify call chain combined with the rest of
# the loop's stack usage (JSON serialization, etc.).
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Log level
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_LOG_DEFAULT_LEVEL=3

# Enable C++ exceptions
CONFIG_COMPILER_CXX_EXCEPTIONS=y

# WiFi
CONFIG_ESP_WIFI_ENABLED=y
CONFIG_ESP_WIFI_SOFTAP_ENABLED=n
CONFIG_LWIP_MAX_SOCKETS=12
CONFIG_LWIP_SO_RCVBUF=y

# lwip TCP buffers — larger buffers reduce EAGAIN when WiFi clients
# have slow ACK paths (e.g. iOS power management)
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=16384
CONFIG_LWIP_TCP_WND_DEFAULT=16384

# Flash size 4MB
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# OTA rollback safety net: an image that never confirms itself valid
# (crash/watchdog reset before esp_ota_mark_app_valid_cancel_rollback())
# is automatically reverted to the previous slot on next boot.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_APP_ROLLBACK_ENABLE=y

# Reclaim IRAM for OTA rollback support: run WiFi's RX-path interrupt code
# from flash cache instead of IRAM. Negligible cost for this app's low WiFi
# throughput (a small TCP/BLE bridge), and needed to fit the rollback flags
# above within the IRAM budget.
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
